  "info": {
    "_postman_id": "00c55ba7-fa4f-4647-b0d3-07efaff06514",
    "name": "DetectLanguage Account Detection API",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json",
    "description": {
      "content": "DetectLanguage is a language detection REST API that analyzes text samples and returns the identified language along with a confidence score. Supporting 216 languages, the API enables developers to identify languages from brief phrases to full documents, with batch processing support for multiple texts in a single request.",
      "type": "text/plain"
    }
