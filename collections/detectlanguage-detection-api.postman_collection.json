          "name": "Detect language of a single text",
          "request": {
            "name": "Detect language of a single text",
            "description": {
              "content": "Analyzes a single text string and returns an array of language candidates with language codes and confidence scores. Higher score means higher detection confidence (0 to 1 range).",
              "type": "text/plain"
            },
            "url": {
